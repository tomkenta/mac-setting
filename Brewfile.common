# Shared work tools. Installation belongs here, never in dotfiles.
common_prefix = ENV.fetch("HOMEBREW_PREFIX")
ENV["PATH"] = "#{common_prefix}/opt/node@24/bin:#{common_prefix}/bin:#{ENV.fetch('PATH')}"
brew "node@24"
brew "uv"
brew "git"
brew "git-lfs"
brew "gh"
brew "ghq"
brew "tmux"
brew "ripgrep"
brew "gitleaks"
brew "git-delta"
brew "fzf"
brew "starship"
brew "zoxide"
brew "direnv"
brew "fd"
brew "eza"
brew "bat"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "zsh-completions"
cask "claude-code"
cask "codex"
cask "claude"
cask "google-chrome"
cask "tailscale-app"
